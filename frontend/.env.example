# Backend base URL (no trailing slash). API calls go to ${REACT_APP_BACKEND_URL}/api/...
# This is baked in at build time — rebuild after changing it.
# Production: the Render service URL, e.g. https://brief-hub-api.onrender.com
REACT_APP_BACKEND_URL=

# Local dev-server niceties (not used in production builds)
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
