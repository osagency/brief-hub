# --- Database (required) ---
# Local dev: mongodb://localhost:27017
# Production: MongoDB Atlas SRV URI, e.g. mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL=
DB_NAME=openspace_agency_os

# --- Auth (required) ---
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# --- Emergent (required) ---
# Used for both AI features (Claude via Emergent's LLM proxy) and file/attachment storage.
EMERGENT_LLM_KEY=

# --- CORS (recommended in production) ---
# Comma-separated list of allowed origins. Defaults to * if unset.
CORS_ORIGINS=https://huzefa.test.osagency.in

# --- Leads module (optional) ---
# Webhook URL that receives outbound lead events; leave empty to disable.
LEADS_OUTBOUND_WEBHOOK=
# Shared secret for the inbound leads webhook endpoint; leave empty to disable.
LEADS_INBOUND_SECRET=
