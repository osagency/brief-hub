# --- Database (required) ---
# Local dev: mongodb://localhost:27017
# Production: MongoDB Atlas SRV URI, e.g. mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL=
DB_NAME=openspace_agency_os

# --- Auth (required) ---
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# --- Emergent (required) ---
# Used for both AI features (Claude via Emergent's LLM proxy) and file/attachment storage.
EMERGENT_LLM_KEY=

# --- CORS (recommended in production) ---
# Comma-separated list of allowed origins. Defaults to * if unset.
CORS_ORIGINS=https://huzefa.test.osagency.in

# --- Leads module (optional) ---
# Webhook URL that receives outbound lead events; leave empty to disable.
LEADS_OUTBOUND_WEBHOOK=
# Shared secret for the inbound leads webhook endpoint; leave empty to disable.
LEADS_INBOUND_SECRET=

# --- Gmail sync via Google Workspace domain-wide delegation (optional) ---
# Service account JSON for the account granted domain-wide delegation over
# @osagency.in. Supply EITHER a path to the file, or the JSON itself
# (raw or base64-encoded) — the latter is what Render and other hosts want,
# since they provide no filesystem to place a key file on.
# Leave both empty to disable Gmail sync; the app degrades gracefully and the
# Smart Inbox simply shows no Gmail-sourced mail.
# NEVER commit the key itself — .gitignore excludes gmail_sa*.json.
GMAIL_SA_FILE=
GMAIL_SA_JSON=

# Bearer token required by POST /api/cron/gmail-sync, which triggers the
# 15-minute background sync. Must match the token the external scheduler sends.
WEBHOOK_CRON_SECRET=
